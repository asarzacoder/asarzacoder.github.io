<%- include("partials/header.ejs") %>

<body>

  <main class="container page-container">

    <h1>Quotes Found</h1>

    <nav>
      <a href="/">Home</a>
    </nav>

    <p class="search-description">
      <%= searchDescription %>
    </p>

    <section class="results-container">

      <!-- Shows a message when the search returns no quotes 1 -->
      <% if (quotes.length === 0) { %>

        <p>No quotes were found.</p>

      <% } %>

      <!-- Loops through every quote returned by MySQL 2 -->
      <% for (const item of quotes) { %>

        <article class="quote-card">

          <p>
            <%= item.quote %>
          </p>

          <p>
            <em>
              -
              <!-- The author ID is stored so JavaScript knows which author to fetch 3 -->
              <a
                href="#"
                class="author-link"
                data-author-id="<%= item.authorId %>">

                <%= item.firstName %>
                <%= item.lastName %>

              </a>
            </em>
          </p>

        </article>

      <% } %>

    </section>

    <!-- Bootstrap modal used to display author information 4 -->
    <div
      class="modal fade"
      id="authorModal"
      tabindex="-1"
      aria-labelledby="authorModalLabel"
      aria-hidden="true">

      <div class="modal-dialog modal-lg">

        <div class="modal-content">

          <div class="modal-header">

            <h1
              class="modal-title fs-5"
              id="authorModalLabel">

              Author Information

            </h1>

            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close">
            </button>

          </div>

          <div class="modal-body">

            <!-- JavaScript places the selected author information here 5 -->
            <div id="authorInfo"></div>

          </div>

          <div class="modal-footer">

            <button
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal">

              Close

            </button>

          </div>

        </div>

      </div>

    </div>

    <%- include("partials/footer.ejs") %>

  </main>

  <!-- Loads the JavaScript used for the author modal 6 -->
  <script src="/js/scripts.js"></script>

</body>
</html>