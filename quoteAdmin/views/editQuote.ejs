<%- include("partials/header.ejs") %>

<section class="library-panel">

  <h1>Updating Quote Data</h1>

  <p>
    Edit the selected quote's library record.
  </p>

  <!-- Updates the selected quote using POST 1 -->
  <form method="POST" action="/quote/edit" class="data-form">

    <!-- Stores the quote ID without displaying it 2 -->
    <input
      type="hidden"
      name="quoteId"
      value="<%= quoteInfo[0].quoteId %>">

    <div class="form-group">
      <label for="quote">Quote</label>

      <textarea
        id="quote"
        name="quote"
        rows="6"
        required><%= quoteInfo[0].quote %></textarea>
    </div>

    <div class="form-group">
      <label for="authorId">Author</label>

      <select id="authorId" name="authorId" required>

        <!-- Selects the quote's current author 3 -->
        <% for (let i = 0; i < authors.length; i++) { %>

          <option
            value="<%= authors[i].authorId %>"
            <%= authors[i].authorId === quoteInfo[0].authorId ? "selected" : "" %>>

            <%= authors[i].firstName %>
            <%= authors[i].lastName %>

          </option>

        <% } %>

      </select>
    </div>

    <div class="form-group">
      <label for="category">Category</label>

      <input
        type="text"
        id="category"
        name="category"
        value="<%= quoteInfo[0].category %>"
        required>
    </div>

    <div class="form-group">
      <label for="likes">Likes</label>

      <input
        type="number"
        id="likes"
        name="likes"
        min="0"
        value="<%= quoteInfo[0].likes %>"
        required>
    </div>

    <button class="action-button">
      Update Quote
    </button>

  </form>

  <div class="page-navigation">
    <a href="/quotes">Back to Quotes</a>
  </div>

</section>

<%- include("partials/footer.ejs") %>